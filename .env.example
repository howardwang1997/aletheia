# ---------------------------------------------------------------------------
# Aletheia configuration. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---
ALETHEIA_DATABASE_URL=postgresql+psycopg://aletheia:aletheia@localhost:5432/aletheia
# Formal real runs require a clean git tree. Keep false for release evidence; true is an explicit
# development-only escape hatch whose dirty patch hash remains recorded in the manifest.
ALETHEIA_ALLOW_DIRTY_FROZEN_MANIFEST=false

# --- Orchestrator: choose one provider for the scientist + isolated workers ---
# "claude" uses the Claude Agent SDK; "openai" uses Codex subscription or Responses API.
ALETHEIA_ORCHESTRATOR_PROVIDER=claude

# Claude provider
# auth_mode: "subscription" (default, cheaper) or "api_key"
ALETHEIA_CLAUDE_AUTH_MODE=subscription
# Subscription mode: if this machine is already logged into Claude Code, leave
# this BLANK — Aletheia inherits your existing login (macOS Keychain) automatically.
# Only set it for remote/headless servers: run `claude setup-token` and paste here.
CLAUDE_CODE_OAUTH_TOKEN=
# For api_key mode (also a fallback for higher throughput):
ANTHROPIC_API_KEY=
ALETHEIA_CLAUDE_MODEL=claude-opus-4-8

# OpenAI provider. "subscription" reuses `codex login` (ChatGPT plan, no API key);
# "api_key" calls the Responses API. Run `codex login status` to inspect the active login.
ALETHEIA_OPENAI_AUTH_MODE=subscription
ALETHEIA_CODEX_COMMAND=codex
ALETHEIA_CODEX_TIMEOUT_S=240
# Required only for auth_mode=api_key. Also reused if the OpenAI API critic is enabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ALETHEIA_OPENAI_MODEL=gpt-5.6-sol
ALETHEIA_OPENAI_REASONING_EFFORT=high
ALETHEIA_OPENAI_MAX_OUTPUT_TOKENS=16384

# --- Cross-vendor critics (always billed by their own vendors) ---
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Zhipu / GLM — its "GLM Coding Plan" subscription is consumed via a plain key
# on an OpenAI/Anthropic-compatible endpoint (no subprocess needed).
ZHIPU_API_KEY=
# GLM endpoint URL (OpenAI-compatible). Overrides the base_url in critics.yaml.
# e.g. https://open.bigmodel.cn/api/paas/v4  (or your GLM Coding-Plan endpoint)
ZHIPU_BASE_URL=
# DeepSeek endpoint override (optional; defaults to critics.yaml base_url)
DEEPSEEK_BASE_URL=

# --- Notifications: Feishu (飞书) custom-bot webhook ---
FEISHU_WEBHOOK_URL=

# --- GitHub App (IAM: repo-per-project, branch + PR per experiment) ---
# Register a GitHub App (github.com/settings/apps/new) with permissions:
#   Administration: R/W (create repos) · Contents: R/W · Pull requests: R/W · Metadata: R
# Install it on your account/org — repos are created there. Then fill in:
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Provide the private key EITHER inline (PEM contents) OR as a file path:
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Owner the repos live under (defaults to the App's install account if blank):
GITHUB_OWNER=
# Set true if GITHUB_OWNER is an organization (false = personal account):
GITHUB_OWNER_IS_ORG=false

# --- Data sources (Phase 1+) ---
# Materials Project API key (free; register at materialsproject.org)
MP_API_KEY=
# Domains: "materials" (matbench_expt_gap; needs matminer) and "molecules" (MoleculeNet
# ESOL solubility; needs rdkit + downloads the ESOL CSV on first real run). Dry-run +
# unit tests are offline for both. The domain is set per run by the scoping plan.

# --- Platform IAM: who may operate the dashboard/API ---
# Owner bootstrap — seeds a local-password login on first boot (then log in at the UI):
ALETHEIA_OWNER_EMAIL=
ALETHEIA_OWNER_PASSWORD=
# Allow not-yet-linked logins (email or phone, comma-separated). Empty = only the
# owner + already-linked identities may sign in (no open self-registration):
ALETHEIA_ALLOWED_LOGINS=
# GitHub OAuth *login* (distinct from the GitHub App used for repo IAM above).
# Register an OAuth app; callback = <app_base_url>/auth/github/callback :
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Feishu (Lark) OAuth login — app id/secret (callback = <app_base_url>/auth/feishu/callback):
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Phone OTP: dev mode logs the code (set ALETHEIA_PHONE_OTP_DEV_MODE=false +
# SMS_WEBHOOK_URL to actually send SMS):
SMS_WEBHOOK_URL=

# --- Compute sandbox ---
# "docker" is the production default. The host featurizes + stages X/y and a
# no-network container runs all untrusted model code. Build from the repo root:
#   docker build -t aletheia-sandbox:latest -f docker/sandbox.Dockerfile .
ALETHEIA_COMPUTE_BACKEND=docker
ALETHEIA_AUTHORED_CODE_BACKEND=docker
# Development-only escape hatch. Unattended real runs still refuse this mode.
ALETHEIA_ALLOW_UNSAFE_HOST_AUTHORED_CODE=false
# Still fail closed, but allow a newly rebuilt image to cold-start on Docker Desktop.
ALETHEIA_SANDBOX_PREFLIGHT_TIMEOUT_S=120
# For SOTA deep models (CPU torch), build + point at the heavier image:
#   docker build -t aletheia-sandbox-sota:latest -f docker/sandbox-sota.Dockerfile .
#   ALETHEIA_SANDBOX_DOCKER_IMAGE=aletheia-sandbox-sota:latest
ALETHEIA_SANDBOX_DOCKER_IMAGE=aletheia-sandbox:latest
# Dedicated F7 research-plane image. This image intentionally contains no Aletheia/evaluator code.
ALETHEIA_EVALUATOR_AGENT_DOCKER_IMAGE=aletheia-evaluator-agent:latest
ALETHEIA_SCIENCEAGENTBENCH_DOCKER_IMAGE=aletheia-scienceagentbench:latest
# Offline runtime for the reviewed Asta CORE-Bench-Hard public-validation mini-suite.
ALETHEIA_COREBENCH_DOCKER_IMAGE=aletheia-corebench:latest
# Two-plane DiscoveryWorld runtime: the candidate image contains only stdlib Python; the trusted
# environment image contains the pinned official simulator and is never mounted to candidates.
ALETHEIA_DISCOVERYWORLD_CANDIDATE_DOCKER_IMAGE=aletheia-discoveryworld-candidate:latest
ALETHEIA_DISCOVERYWORLD_DOCKER_IMAGE=aletheia-discoveryworld:latest

# --- Epistemic Seal v2 (adaptive campaigns) ---
# All row roles are fixed before ideation: one reusable exploration pool, fresh
# disjoint confirmation batches, and a one-time final holdout.  Register a second
# DataAsset with role=external_validation and set REQUIRED=true for release campaigns.
ALETHEIA_CAMPAIGN_SEAL_V2_ENABLED=true
ALETHEIA_CAMPAIGN_SPLIT_SEED=20260812
ALETHEIA_CAMPAIGN_EXPLORE_FRACTION=0.50
ALETHEIA_CAMPAIGN_FINAL_HOLDOUT_FRACTION=0.20
ALETHEIA_CAMPAIGN_FAMILY_ALPHA=0.05
ALETHEIA_CAMPAIGN_FINAL_ALPHA=0.01
ALETHEIA_CAMPAIGN_EXTERNAL_VALIDATION_REQUIRED=false
ALETHEIA_CAMPAIGN_EXTERNAL_ALPHA=0.05
ALETHEIA_CAMPAIGN_EXTERNAL_TIMEOUT_S=600

# --- Embeddings (semantic recall + the RAG domain's dense retriever) ---
# "local" = sentence-transformers (all-MiniLM-L6-v2); downloads ~80MB on first use,
#           then runs offline. "hash" = a random offline stub (tests/dry-run).
# The rag domain's DENSE retriever needs the "local" backend to be meaningful; with
# "hash" (or in dry-run) it falls back to the lexical retriever.
ALETHEIA_EMBEDDING_BACKEND=local

# --- Budget guardrails (per run) ---
ALETHEIA_BUDGET_USD=20
ALETHEIA_BUDGET_GPU_HOURS=4
ALETHEIA_MAX_CONCURRENT_JOBS=2
ALETHEIA_WALL_CLOCK_HOURS=24
